GROQ_API_KEY=gsk_your_groq_api_key_here
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pharmacy_complaints
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# NOTE: gemma2-9b-it and llama-3.3-70b-versatile have been decommissioned on
# Groq (verified Sept 2026) — defaults now use Groq's OpenAI-preview family.
PRIMARY_MODEL=openai/gpt-oss-20b
FALLBACK_MODEL=openai/gpt-oss-120b
MAX_FILE_SIZE_MB=10
DATE_TOLERANCE_DAYS=7
APP_ENV=development
